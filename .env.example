# ============================================================
# OCR Toolkit — Environment Configuration
# Copy to ".env":   cp .env.example .env
# Do NOT commit the real ".env".
# ============================================================

# ---------- Ports ----------
CLIENT_HOST_PORT=8067
CLIENT_CONTAINER_PORT=8501
API_CONTAINER_PORT=8491
OCR_API_URL=http://api:8491

# ---------- API: OCR / Upload ----------
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
MAX_UPLOAD_MB=50
OCR_PDF_DPI=250
OCR_MAX_IMAGE_DIM=3200
OCR_WORKDIR=/tmp/ocr-api
OCR_JOB_TTL_MINUTES=60

# ---------- Concurrency ----------
# Gunicorn worker processes (parallel requests). Company server -> raise freely.
API_PROCESS_WORKERS=4
# Page-workers PER request. Keep small so many users share fairly.
# Total Tesseract load ~= API_PROCESS_WORKERS * OCR_MAX_WORKERS.
OCR_MAX_WORKERS=2

# ---------- Shared job state ----------
REDIS_URL=redis://redis:6379/0

# ---------- Memory guard ----------
API_MEMORY_LIMIT=12g

# ---------- Gemini (DEVELOPER-ONLY, not exposed to UI) ----------
# Leave GEMINI_ENABLED=false to always use Tesseract + cv2.
# Set true AND provide a key to enable optional post-OCR correction.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- Runtime ----------
ENVIRONMENT=production
LOG_LEVEL=INFO

# ---------- Client timeouts (seconds) ----------
API_CONNECT_TIMEOUT=5
API_READ_TIMEOUT=900
API_HEALTH_RETRIES=3
